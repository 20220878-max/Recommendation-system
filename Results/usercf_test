similarity matrix.\n","k=20 저장 완료\n","\n","===== K = 50 =====\n","Computing the cosine similarity matrix...\n","Done computing similarity matrix.\n","k=50 저장 완료\n","\n","===== K = 100 =====\n","Computing the cosine similarity matrix...\n","Done computing similarity matrix.\n","k=100 저장 완료\n"]}]},{"cell_type":"code","source":["import numpy as np\n","\n","# recommendation 딕셔너리 만들기\n","recommendations = {}\n","\n","for uid in recommend_df['user_id'].unique():\n","    user_recs = recommend_df[\n","        recommend_df['user_id'] == uid\n","    ].sort_values('rank')\n","\n","    recommendations[uid] = list(user_recs['item_id'])\n","\n","# 전체 아이템 개수\n","n_items = train['item_id'].nunique()\n","\n","# 인기 영화 topK\n","popular_topk = set(\n","    train['item_id']\n","    .value_counts()\n","    .head(10)\n","    .index\n",")\n","\n","# 영화 popularity\n","popularity_counts = (\n","    train['item_id']\n","    .value_counts()\n","    .to_dict()\n",")\n","\n","n_users = train['user_id'].nunique()\n","\n","# 랜덤 item vector (diversity용 임시)\n","Q = np.random.rand(n_items + 1, 20)\n","\n","# Coverage\n","def coverage(recs, n_items):\n","    rec_set = set()\n","\n","    for its in recs.values():\n","        rec_set.update(its)\n","\n","    return len(rec_set) / n_items\n","\n","# Serendipity\n","def serendipity(recs, popular_set, K):\n","    s = [\n","        sum(1 for i in its[:K] if i not in popular_set) / K\n","        for its in recs.values()\n","    ]\n","\n","    return np.mean(s)\n","\n","# Novelty\n","def novelty(recs, pop_counts, n_users, K):\n","    s = []\n","\n","    for its in recs.values():\n","        novs = [\n","            -np.log2(\n","                max(pop_counts.get(i, 1) / n_users, 1e-9)\n","            )\n","            for i in its[:K]\n","        ]\n","\n","        s.append(np.mean(novs))\n","\n","    return np.mean(s)\n","\n","# Diversity\n","def diversity(recs, Q, K):\n","    s = []\n","\n","    for its in recs.values():\n","        topk = its[:K]\n","\n","        if len(topk) < 2:\n","            continue\n","\n","        vecs = Q[topk]\n","\n","        normed = vecs / (\n","            np.linalg.norm(vecs, axis=1, keepdims=True) + 1e-9\n","        )\n","\n","        sim = normed @ normed.T\n","\n","        n = len(topk)\n","\n","        avg_sim = np.sum(\n","            np.triu(sim, k=1)\n","        ) / (n * (n - 1) / 2)\n","\n","        s.append(1 - avg_sim)\n","\n","    return np.mean(s)\n","\n","# 출력\n","print(\"Coverage =\", coverage(recommendations, n_items))\n","print(\"Serendipity =\", serendipity(recommendations, popular_topk, 10))\n","print(\"Novelty =\", novelty(recommendations, popularity_counts, n_users, 10))\n","print(\"Diversity =\", diversity(recommendations, Q, 10))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"iYnzhyu3W7YW","executionInfo":{"status":"ok","timestamp":1779951191731,"user_tz":-540,"elapsed":1670,"user":{"displayName":"둠둠","userId":"03826002626831308883"}},"outputId":"36ddd1e6-c672-4cc1-d4ed-95728907f231"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Coverage = 0.4851190476190476\n","Serendipity = 0.6387978142076502\n","Novelty = 2.6568155530410573\n","Diversity = 0.2446477145229629\n"]}]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":17815,"status":"ok","timestamp":1779360490893,"user":{"displayName":"둠둠","userId":"03826002626831308883"},"user_tz":-540},"id":"gDNTO6hTJgUk","outputId":"8d9fdc15-beed-4a54-d28b-10f7d8559115"},"outputs":[{"name":"stdout","output_type":"stream","text":["\n","=== k = 5 학습 중 ===\n","Computing the cosine similarity matrix...\n","Done computing similarity matrix.\n","RMSE: 1.0866\n","val RMSE = 1.0866039685917244\n","\n","=== k = 10 학습 중 ===\n","Computing the cosine similarity matrix...\n","Done computing similarity matrix.\n","RMSE: 1.0434\n","val RMSE = 1.0434421563189624\n","\n","=== k = 20 학습 중 ===\n","Computing the 